generator client {
  provider = "prisma-client"
  output   = "../src/generated_prisma"
}

datasource db {
  provider = "postgresql"
}

/// 앱 회원. id는 Supabase Auth 사용자(auth.users)의 id를 그대로 쓴다.
/// 로그인·가입에 성공하면 서버가 이 행을 만든다(upsert). 비밀번호는 Supabase Auth가 관리하고 여기에는 두지 않는다.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans    ScanRecord[]
  contacts Contact[]

  @@map("users")
}

/// 검사 종류: 문자·카톡 메시지(MESSAGE) 또는 QR 코드(QR)
enum ScanKind {
  MESSAGE
  QR
}

/// 메시지를 받은 곳. QR 검사는 QR로 기록한다.
enum ScanSource {
  SMS
  KAKAO
  OTHER
  QR
}

/// 위험도: 안전(SAFE) · 주의(CAUTION) · 위험(DANGER)
enum RiskLevel {
  SAFE
  CAUTION
  DANGER
}

/// 메시지·QR 검사 기록. 주요 기능 1(메시지)·2(QR)가 함께 쓴다.
/// 읽기·고치기·지우기는 항상 userId 조건을 함께 건다(내 자료만).
model ScanRecord {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  kind      ScanKind
  source    ScanSource
  /// 검사한 메시지 본문 또는 QR 안의 내용(주소). 화면에는 글자 그대로만 보여 준다(HTML로 넣지 않음).
  content   String
  riskLevel RiskLevel
  /// 위험하다고 본 이유(쉬운 말 문장 목록)
  reasons   String[]
  /// AI 분석 설명. AI 기능을 연결하기 전에는 비어 있다.
  aiSummary String?
  /// 사용자가 남기는 메모(예: "은행에 전화해 확인함")
  memo      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("scan_records")
}

/// 보호자·연락처. 주요 기능 3. 음성 도우미의 "○○한테 전화"와 위험 알림이 이 목록을 쓴다.
model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String
  /// 숫자만 저장한다(예: 01012345678)
  phone      String
  /// 관계(예: 아들, 딸, 복지사)
  relation   String?
  /// 위험 문자를 받았을 때 알릴 보호자인지
  isGuardian Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId, name])
  @@map("contacts")
}
